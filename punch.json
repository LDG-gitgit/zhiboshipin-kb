{"version":"2026-11-1","name":"金句库","tree":[{"id":"punch-hook","name":"开场钩子"},{"id":"punch-title","name":"标题公式"},{"id":"punch-heart","name":"扎心金句"},{"id":"punch-heal","name":"治愈金句"},{"id":"punch-end","name":"合规结尾引导"},{"id":"punch-script","name":"短视频脚本结构"}],"entries":[{"id":"punch-hook-01","path":["开场钩子"],"title":"开场·收窄主题式","keywords":["开场","钩子","主题","留人","3秒"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「今天只讲一件事：___到底怎么选。」开场先收窄主题，观众知道留下来能听到什么，不铺垫、不寒暄。"}]},{"id":"punch-hook-02","path":["开场钩子"],"title":"开场·先别急着买","keywords":["开场","钩子","别急","信任","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「先别急着买，看完这三点再决定。」把决定权还给观众，降低防备心，也让后面的内容有了理由。"}]},{"id":"punch-hook-03","path":["开场钩子"],"title":"开场·行业经历式","keywords":["开场","钩子","经历","信任","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「我在这个行业干了几年，今天说点实在的。」用经历建立可信度，注意别编年限，干几年说几年。"}]},{"id":"punch-hook-04","path":["开场钩子"],"title":"开场·共同踩坑式","keywords":["开场","钩子","踩坑","共鸣","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「很多人买___都踩过同一个坑，今天把它讲透。」用共同经历开头，观众容易对号入座。"}]},{"id":"punch-hook-05","path":["开场钩子"],"title":"开场·反差提问式","keywords":["开场","钩子","提问","反差","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「同样预算，为什么有人买到的东西差一倍？」用一个具体反差提问，勾起好奇，后文要真的给出解释。"}]},{"id":"punch-hook-06","path":["开场钩子"],"title":"开场·生活场景式","keywords":["开场","钩子","场景","共鸣","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「先问一句：你家的___是不是也这样？」用生活场景开场，观众会下意识对照自己的情况。"}]},{"id":"punch-hook-07","path":["开场钩子"],"title":"开场·演示优先式","keywords":["开场","钩子","演示","细节","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「别听我说，先看这个细节。」把说服力交给演示，适合能当场展示的品类，比形容词管用。"}]},{"id":"punch-hook-08","path":["开场钩子"],"title":"开场·算账式","keywords":["开场","钩子","算账","耐用","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「这东西值不值，算笔账就明白。」用「算账」做钩子，适合耐用品、复购品，后文要给出真实使用周期。"}]},{"id":"punch-hook-09","path":["开场钩子"],"title":"开场·辟谣式","keywords":["开场","钩子","辟谣","误区","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「关于___，有个说法传了很多年，其实是误区。」用辟谣开场，注意必须有可靠依据，不能为了流量造误区。"}]},{"id":"punch-hook-10","path":["开场钩子"],"title":"开场·产地差异式","keywords":["开场","钩子","产地","差异","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「产地不同，___的差别能有多大？」用地缘差异开场，适合水果、茶叶、农产品。"}]},{"id":"punch-hook-11","path":["开场钩子"],"title":"开场·预算有限式","keywords":["开场","钩子","预算","价格","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「预算有限怎么选？这条给你讲清楚。」直接服务价格敏感人群，不绕弯子，后文要给真方法。"}]},{"id":"punch-hook-12","path":["开场钩子"],"title":"开场·一句话式","keywords":["开场","钩子","一句话","记忆点","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「如果只记一句话，记住这句：___。」给观众一个「带走」的理由，这句话要真的有用。"}]},{"id":"punch-hook-13","path":["开场钩子"],"title":"开场·时令式","keywords":["开场","钩子","时令","季节","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「这个季节买___，有件事你得先知道。」用时令切入，适合换季品和生鲜，信息要经得起核对。"}]},{"id":"punch-hook-14","path":["开场钩子"],"title":"开场·对比式","keywords":["开场","钩子","对比","实测","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「我把它和常见款放一起，差别一眼就看出来。」用对比开场，后文要真的摆在一起，不空口比较。"}]},{"id":"punch-hook-15","path":["开场钩子"],"title":"开场·新手避坑式","keywords":["开场","钩子","新手","避坑","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「刚开始买___的人，容易在这几个地方吃亏。」身份代入加避坑，术语要当场解释，别让新手听不懂。"}]},{"id":"punch-hook-16","path":["开场钩子"],"title":"开场·价格疑问式","keywords":["开场","钩子","价格","成本","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「为什么同样的东西，价格能差好几倍？」价格疑问是天然钩子，但后文要讲清成本构成，别贬低同行。"}]},{"id":"punch-hook-17","path":["开场钩子"],"title":"开场·习惯质疑式","keywords":["开场","钩子","习惯","包装","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「你买___的时候，是不是只看包装？」指出一个常见习惯，观众会想听下去，后文要给出替代方法。"}]},{"id":"punch-hook-18","path":["开场钩子"],"title":"开场·限时承诺式","keywords":["开场","钩子","时长","节奏","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「30秒，把___讲明白，不耽误你时间。」给出明确时长承诺，节奏要真的快，不能拖成十分钟。"}]},{"id":"punch-hook-19","path":["开场钩子"],"title":"开场·反常识式","keywords":["开场","钩子","反常识","价格","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「越贵的___越好用？不一定。」反常识开场，后面要用事实支撑，不能只抛观点不带证据。"}]},{"id":"punch-hook-20","path":["开场钩子"],"title":"开场·工序揭秘式","keywords":["开场","钩子","工序","原料","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「一件___从原料到成品，要经过几步？」用工序拉开信息差，适合手工艺、食品和农产品。"}]},{"id":"punch-hook-21","path":["开场钩子"],"title":"开场·人群定位式","keywords":["开场","钩子","家人","人群","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「给爸妈买___，这几件事先弄清楚。」人群定位开场，方便对号入座，内容要围绕这个人群的真实需求。"}]},{"id":"punch-hook-22","path":["开场钩子"],"title":"开场·信息差式","keywords":["开场","钩子","信息差","实在","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「买之前没人告诉你的事，今天说三件。」用信息差制造期待，内容要真的实在，不能拿常识凑数。"}]},{"id":"punch-hook-23","path":["开场钩子"],"title":"开场·反套路式","keywords":["开场","钩子","不催单","信任","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「今天不催单，先把东西讲清楚。」反套路开场，降低压迫感，适合需要慢慢建立信任的品类。"}]},{"id":"punch-hook-24","path":["开场钩子"],"title":"开场·适用边界式","keywords":["开场","钩子","适合谁","诚实","留人"],"kind":"punch","dimensions":[{"dim":"钩子","text":"「这个东西适合谁、不适合谁，今天分开说。」用适用边界开场，体现诚实，也帮观众做筛选。"}]},{"id":"punch-title-01","path":["标题公式"],"title":"标题·数字加痛点","keywords":["标题","公式","数字","痛点","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「数字+痛点」：《挑水果别只看大小，记住这3点》——数字给出预期，痛点让人对号入座。"}]},{"id":"punch-title-02","path":["标题公式"],"title":"标题·反常识","keywords":["标题","公式","反常识","价格","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「反常识」：《价格高的___，不一定更适合你》——先打破惯性认知，正文再给出条件。"}]},{"id":"punch-title-03","path":["标题公式"],"title":"标题·身份代入","keywords":["标题","公式","人群","新手","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「身份代入」：《刚开始买___的人，先看这条》——把目标人群写进标题，点进来的人更精准。"}]},{"id":"punch-title-04","path":["标题公式"],"title":"标题·同价位对比","keywords":["标题","公式","对比","价位","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「同价位对比」：《同一个价位，两款___差在哪》——对比自带信息量，注意中立，不贬低任一方。"}]},{"id":"punch-title-05","path":["标题公式"],"title":"标题·悬念式","keywords":["标题","公式","悬念","老手","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「悬念」：《为什么老手都不买这种___》——留一个待解释的问题，正文必须给出答案。"}]},{"id":"punch-title-06","path":["标题公式"],"title":"标题·清单式","keywords":["标题","公式","清单","问题","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「清单」：《买___前要问的5个问题》——清单式标题承诺结构清晰，数量要和正文一致。"}]},{"id":"punch-title-07","path":["标题公式"],"title":"标题·场景式","keywords":["标题","公式","场景","租房","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「场景」：《租房党怎么选___，看这几点》——场景越具体，观众越容易代入自己。"}]},{"id":"punch-title-08","path":["标题公式"],"title":"标题·误区式","keywords":["标题","公式","误区","避坑","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「误区」：《___的3个常见误区，很多人中招》——用误区做标题，内容要有依据，不能编误区。"}]},{"id":"punch-title-09","path":["标题公式"],"title":"标题·时令式","keywords":["标题","公式","时令","换季","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「时令」：《换季买___，什么时候下手合适》——时间点加决策问题，适合季节性商品。"}]},{"id":"punch-title-10","path":["标题公式"],"title":"标题·拆成本式","keywords":["标题","公式","成本","价格","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「拆成本」：《___贵在哪？拆开算给你看》——价格疑问加拆解承诺，后文要有真实的成本构成。"}]},{"id":"punch-title-11","path":["标题公式"],"title":"标题·人群式","keywords":["标题","公式","人群","爸妈","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「人群」：《给爸妈买___，注意这几点》——人群限定清楚，内容围绕这个人群的真实需求。"}]},{"id":"punch-title-12","path":["标题公式"],"title":"标题·方法式","keywords":["标题","公式","方法","挑选","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「方法」：《记住这招，挑___不用靠运气》——给出可操作方法，方法要具体到能照做。"}]},{"id":"punch-title-13","path":["标题公式"],"title":"标题·产地式","keywords":["标题","公式","产地","差异","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「产地」：《产地不同，___差别有多大》——地域差异是农产品、茶叶的天然看点。"}]},{"id":"punch-title-14","path":["标题公式"],"title":"标题·过程式","keywords":["标题","公式","过程","工序","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「过程」：《一件___从原料到成品，经过多少道工序》——工序标题适合手作、食品，正文拆开讲。"}]},{"id":"punch-title-15","path":["标题公式"],"title":"标题·疑问算账式","keywords":["标题","公式","疑问","算账","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「疑问句」：《___到底值不值？算完这笔账再说》——疑问加算账，适合耐用品和复购品。"}]},{"id":"punch-title-16","path":["标题公式"],"title":"标题·劝退式","keywords":["标题","公式","劝退","理性","短视频"],"kind":"punch","dimensions":[{"dim":"公式","text":"「劝退式」：《先别下单，___这三个问题想清楚》——反向标题降低推销感，也筛掉不合适的人。"}]},{"id":"punch-heart-01","path":["扎心金句"],"title":"扎心·没想清楚要什么","keywords":["扎心","金句","需求","选择"],"kind":"punch","dimensions":[{"dim":"金句","text":"很多人不是不会挑，是没想清楚自己到底要什么，结果被价格牵着走。"}]},{"id":"punch-heart-02","path":["扎心金句"],"title":"扎心·买错才是真亏","keywords":["扎心","金句","买错","浪费"],"kind":"punch","dimensions":[{"dim":"金句","text":"买贵了不一定亏，买错了才是真亏——用不上的东西，一块钱也是浪费。"}]},{"id":"punch-heart-03","path":["扎心金句"],"title":"扎心·省钱的尽头","keywords":["扎心","金句","省钱","买对"],"kind":"punch","dimensions":[{"dim":"金句","text":"省钱的尽头不是不买，是买对；买对一次，胜过便宜十次。"}]},{"id":"punch-heart-04","path":["扎心金句"],"title":"扎心·比价之后","keywords":["扎心","金句","比价","需求"],"kind":"punch","dimensions":[{"dim":"金句","text":"商家不怕你比价，怕你比完价还不知道自己要什么。"}]},{"id":"punch-heart-05","path":["扎心金句"],"title":"扎心·判断权","keywords":["扎心","金句","判断","价格"],"kind":"punch","dimensions":[{"dim":"金句","text":"价格是商家定的，值不值是你自己算的，别把判断权交出去。"}]},{"id":"punch-heart-06","path":["扎心金句"],"title":"扎心·快感与账单","keywords":["扎心","金句","冲动","账单"],"kind":"punch","dimensions":[{"dim":"金句","text":"冲动下单的快感很短，账单的提醒很长。"}]},{"id":"punch-heart-07","path":["扎心金句"],"title":"扎心·记住的是价格","keywords":["扎心","金句","直播","需求"],"kind":"punch","dimensions":[{"dim":"金句","text":"看直播容易记住的是价格，容易忘掉的是需求。"}]},{"id":"punch-heart-08","path":["扎心金句"],"title":"扎心·合不合适","keywords":["扎心","金句","合适","顺手"],"kind":"punch","dimensions":[{"dim":"金句","text":"东西没有好坏，只有合不合适；别人说好，不如你用着顺手。"}]},{"id":"punch-heart-09","path":["扎心金句"],"title":"扎心·后悔是具体的","keywords":["扎心","金句","便宜","后悔"],"kind":"punch","dimensions":[{"dim":"金句","text":"便宜是相对的，后悔是具体的——具体到每次用都想换掉它。"}]},{"id":"punch-heart-10","path":["扎心金句"],"title":"扎心·多想一分钟","keywords":["扎心","金句","下单","纠结"],"kind":"punch","dimensions":[{"dim":"金句","text":"买之前多想一分钟，买之后少纠结一个月。"}]},{"id":"punch-heart-11","path":["扎心金句"],"title":"扎心·先定预算","keywords":["扎心","金句","预算","看货"],"kind":"punch","dimensions":[{"dim":"金句","text":"真正会买的人，先定预算再看货，不是看爽了再想办法凑钱。"}]},{"id":"punch-heart-12","path":["扎心金句"],"title":"扎心·缺的是理由","keywords":["扎心","金句","需求","理由"],"kind":"punch","dimensions":[{"dim":"金句","text":"你缺的可能不是一件新东西，是一个说服自己的理由。"}]},{"id":"punch-heart-13","path":["扎心金句"],"title":"扎心·心动与冷静","keywords":["扎心","金句","广告","冷静"],"kind":"punch","dimensions":[{"dim":"金句","text":"广告负责让你心动，你负责让自己冷静，这两件事别搞反。"}]},{"id":"punch-heart-14","path":["扎心金句"],"title":"扎心·耐用也是省钱","keywords":["扎心","金句","耐用","省钱"],"kind":"punch","dimensions":[{"dim":"金句","text":"不是东西变贵了，是你没算过它能用多久——耐用也是省钱。"}]},{"id":"punch-heart-15","path":["扎心金句"],"title":"扎心·下单前停三秒","keywords":["扎心","金句","下单","消费"],"kind":"punch","dimensions":[{"dim":"金句","text":"消费的快乐会递减，账单的记忆不会，所以下单前停三秒。"}]},{"id":"punch-heart-16","path":["扎心金句"],"title":"扎心·比价别忘初衷","keywords":["扎心","金句","货比三家","初衷"],"kind":"punch","dimensions":[{"dim":"金句","text":"货比三家没错，比到忘了自己为什么买，就白比了。"}]},{"id":"punch-heart-17","path":["扎心金句"],"title":"扎心·赠品与凑单","keywords":["扎心","金句","赠品","凑单"],"kind":"punch","dimensions":[{"dim":"金句","text":"赠品越多，越要问一句：我是为东西买单，还是为凑单买单。"}]},{"id":"punch-heart-18","path":["扎心金句"],"title":"扎心·别人晒的是结果","keywords":["扎心","金句","需要","日子"],"kind":"punch","dimensions":[{"dim":"金句","text":"别人晒的是结果，你过的是日子，按自己的需要买，不丢人。"}]},{"id":"punch-heart-19","path":["扎心金句"],"title":"扎心·成年人的体面","keywords":["扎心","金句","体面","量入为出"],"kind":"punch","dimensions":[{"dim":"金句","text":"成年人的体面，一半是挣来的，一半是量入为出攒出来的。"}]},{"id":"punch-heart-20","path":["扎心金句"],"title":"扎心·会过日子","keywords":["扎心","金句","过日子","值得花"],"kind":"punch","dimensions":[{"dim":"金句","text":"所谓会过日子，不是什么都省，是知道什么值得花。"}]},{"id":"punch-heal-01","path":["治愈金句"],"title":"治愈·比昨天顺一点","keywords":["治愈","金句","日子","慢"],"kind":"punch","dimensions":[{"dim":"金句","text":"日子不用过得比别人好，过得比昨天顺一点就行。"}]},{"id":"punch-heal-02","path":["治愈金句"],"title":"治愈·慢慢来","keywords":["治愈","金句","慢慢来","答案"],"kind":"punch","dimensions":[{"dim":"金句","text":"慢慢来，不是所有事都要今天有答案。"}]},{"id":"punch-heal-03","path":["治愈金句"],"title":"治愈·收拾屋子","keywords":["治愈","金句","收拾","心里"],"kind":"punch","dimensions":[{"dim":"金句","text":"把家里收拾干净，心里也会腾出一点地方。"}]},{"id":"punch-heal-04","path":["治愈金句"],"title":"治愈·好好吃饭","keywords":["治愈","金句","吃饭","照顾"],"kind":"punch","dimensions":[{"dim":"金句","text":"好好吃饭，是普通人对自己很实在的照顾。"}]},{"id":"punch-heal-05","path":["治愈金句"],"title":"治愈·累了就歇","keywords":["治愈","金句","累了","歇会儿"],"kind":"punch","dimensions":[{"dim":"金句","text":"累了就歇会儿，活儿不会跑，你会。"}]},{"id":"punch-heal-06","path":["治愈金句"],"title":"治愈·平稳也是本事","keywords":["治愈","金句","生活","平稳"],"kind":"punch","dimensions":[{"dim":"金句","text":"生活不需要每天精彩，平稳地过也是一种本事。"}]},{"id":"punch-heal-07","path":["治愈金句"],"title":"治愈·像炖汤","keywords":["治愈","金句","急不来","火候"],"kind":"punch","dimensions":[{"dim":"金句","text":"有些事急不来，像炖汤，火候到了自然香。"}]},{"id":"punch-heal-08","path":["治愈金句"],"title":"治愈·允许什么都不做","keywords":["治愈","金句","允许","休息"],"kind":"punch","dimensions":[{"dim":"金句","text":"允许自己偶尔什么都不做，那不是浪费。"}]},{"id":"punch-heal-09","path":["治愈金句"],"title":"治愈·出门走走","keywords":["治愈","金句","心情","走走"],"kind":"punch","dimensions":[{"dim":"金句","text":"东西旧了可以换，心情旧了就出门走走。"}]},{"id":"punch-heal-10","path":["治愈金句"],"title":"治愈·自己喜欢的样子","keywords":["治愈","金句","日子","羡慕"],"kind":"punch","dimensions":[{"dim":"金句","text":"把日子过成自己喜欢的样子，比过成别人羡慕的样子重要。"}]},{"id":"punch-heal-11","path":["治愈金句"],"title":"治愈·记得添衣","keywords":["治愈","金句","添衣","自己"],"kind":"punch","dimensions":[{"dim":"金句","text":"天冷了记得添衣，没人提醒就自己记得。"}]},{"id":"punch-heal-12","path":["治愈金句"],"title":"治愈·忙与闲","keywords":["治愈","金句","忙","闲"],"kind":"punch","dimensions":[{"dim":"金句","text":"忙的时候照顾好事情，闲的时候照顾好自己。"}]},{"id":"punch-heal-13","path":["治愈金句"],"title":"治愈·平凡的一天","keywords":["治愈","金句","平凡","认真"],"kind":"punch","dimensions":[{"dim":"金句","text":"平凡的一天，也值得认真过完，认真吃好每顿饭。"}]},{"id":"punch-heal-14","path":["治愈金句"],"title":"治愈·自己的节奏","keywords":["治愈","金句","节奏","追赶"],"kind":"punch","dimensions":[{"dim":"金句","text":"不用追赶别人，按自己的节奏走，也是往前走。"}]},{"id":"punch-heal-15","path":["治愈金句"],"title":"治愈·吃饭睡觉","keywords":["治愈","金句","吃饭","睡觉"],"kind":"punch","dimensions":[{"dim":"金句","text":"吃饭时吃饭，睡觉时睡觉，这就是本事。"}]},{"id":"punch-heal-16","path":["治愈金句"],"title":"治愈·都会过去","keywords":["治愈","金句","过去","不顺"],"kind":"punch","dimensions":[{"dim":"金句","text":"很多当时觉得过不去的事，后来都过去了。"}]},{"id":"punch-heal-17","path":["治愈金句"],"title":"治愈·照顾好今天","keywords":["治愈","金句","今天","照顾"],"kind":"punch","dimensions":[{"dim":"金句","text":"你不需要一直很厉害，你只需要照顾好今天的自己。"}]},{"id":"punch-heal-18","path":["治愈金句"],"title":"治愈·有事做有人念","keywords":["治愈","金句","日子","烟火气"],"kind":"punch","dimensions":[{"dim":"金句","text":"愿你有事做，有人念，有饭香，也有觉睡。"}]},{"id":"punch-end-01","path":["合规结尾引导"],"title":"收尾·有需要再回来看","keywords":["结尾","收尾","合规","中性"],"kind":"punch","dimensions":[{"dim":"收尾","text":"今天就讲到这儿，有需要再回来看。"}]},{"id":"punch-end-02","path":["合规结尾引导"],"title":"收尾·买不买你决定","keywords":["结尾","收尾","合规","决定权"],"kind":"punch","dimensions":[{"dim":"收尾","text":"链接放在那儿，买不买你自己决定。"}]},{"id":"punch-end-03","path":["合规结尾引导"],"title":"收尾·公屏提问","keywords":["结尾","收尾","合规","公屏"],"kind":"punch","dimensions":[{"dim":"收尾","text":"有任何问题打在公屏上，我看到就答。"}]},{"id":"punch-end-04","path":["合规结尾引导"],"title":"收尾·按需选择","keywords":["结尾","收尾","合规","理性"],"kind":"punch","dimensions":[{"dim":"收尾","text":"今天的介绍就到这里，按需选择，理性下单。"}]},{"id":"punch-end-05","path":["合规结尾引导"],"title":"收尾·不合适别拍","keywords":["结尾","收尾","合规","不合适"],"kind":"punch","dimensions":[{"dim":"收尾","text":"不合适就别拍，省得买回来又来回折腾。"}]},{"id":"punch-end-06","path":["合规结尾引导"],"title":"收尾·下播前提问","keywords":["结尾","收尾","合规","疑问"],"kind":"punch","dimensions":[{"dim":"收尾","text":"看完还有疑问，下播前在公屏问我就行。"}]},{"id":"punch-end-07","path":["合规结尾引导"],"title":"收尾·你自己判断","keywords":["结尾","收尾","合规","判断"],"kind":"punch","dimensions":[{"dim":"收尾","text":"我把知道的都说了，剩下的你自己判断。"}]},{"id":"punch-end-08","path":["合规结尾引导"],"title":"收尾·帮你分析","keywords":["结尾","收尾","合规","犹豫"],"kind":"punch","dimensions":[{"dim":"收尾","text":"还在犹豫的话，把纠结的点打在公屏上，我帮你分析。"}]},{"id":"punch-end-09","path":["合规结尾引导"],"title":"收尾·谢谢看完","keywords":["结尾","收尾","合规","感谢"],"kind":"punch","dimensions":[{"dim":"收尾","text":"这场的介绍到此为止，谢谢你看完。"}]},{"id":"punch-end-10","path":["合规结尾引导"],"title":"收尾·按需购买","keywords":["结尾","收尾","合规","按需"],"kind":"punch","dimensions":[{"dim":"收尾","text":"东西合不合适，用过才知道，按需购买。"}]},{"id":"punch-end-11","path":["合规结尾引导"],"title":"收尾·想清楚再来","keywords":["结尾","收尾","合规","想想"],"kind":"punch","dimensions":[{"dim":"收尾","text":"想再想想没关系，想清楚再回来。"}]},{"id":"punch-end-12","path":["合规结尾引导"],"title":"收尾·什么时候需要什么时候看","keywords":["结尾","收尾","合规","不着急"],"kind":"punch","dimensions":[{"dim":"收尾","text":"不着急，什么时候需要什么时候看。"}]},{"id":"punch-script-01","path":["短视频脚本结构"],"title":"脚本·45到60秒四段式","keywords":["脚本","结构","短视频","节奏","钩子"],"kind":"punch","dimensions":[{"dim":"结构","text":"结构：3秒钩子，一句反常识或场景；15秒痛点展开；20秒给方法或演示；5秒中性收尾。总长控制在45到60秒，每段只讲一件事。"}]},{"id":"punch-script-02","path":["短视频脚本结构"],"title":"脚本·演示型","keywords":["脚本","结构","演示","对比","短视频"],"kind":"punch","dimensions":[{"dim":"结构","text":"演示型：开场一句「先看效果」，直接上手演示2到3个关键动作，中途插入一次对比，结尾说明适用人群和不适用人群。"}]},{"id":"punch-script-03","path":["短视频脚本结构"],"title":"脚本·清单型","keywords":["脚本","结构","清单","短视频","总结"],"kind":"punch","dimensions":[{"dim":"结构","text":"清单型：开场报出数字「3个要点」，逐条讲，每条配一个画面或一个动作，结尾用一句话总结，方便观众记住。"}]},{"id":"punch-script-04","path":["短视频脚本结构"],"title":"脚本·故事型","keywords":["脚本","结构","故事","转折","短视频"],"kind":"punch","dimensions":[{"dim":"结构","text":"故事型：人物困境，一个具体的转折细节，产品或方法出现，结果点到为止。注意不夸大结果，不编造情节。"}]},{"id":"punch-script-05","path":["短视频脚本结构"],"title":"脚本·评测型","keywords":["脚本","结构","评测","对比","中立"],"kind":"punch","dimensions":[{"dim":"结构","text":"评测型：抛出对比对象，逐项实测材质、做工、使用感受，给结论时同时说不适合谁，保持中立。"}]},{"id":"punch-script-06","path":["短视频脚本结构"],"title":"脚本·辟谣型","keywords":["脚本","结构","辟谣","依据","短视频"],"kind":"punch","dimensions":[{"dim":"结构","text":"辟谣型：先说流传的说法，给出可靠依据，演示验证，最后给正确做法。依据要能说清来源，不制造新误区。"}]}]}